#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f graphify-out/graph.json ]; then
    echo "ERROR: graphify-out/graph.json not found. Build the graph first (see llm/GRAPHIFY.md)." >&2
    exit 1
fi

if [ -n "${GEMINI_API_KEY:-}" ] || [ -n "${GOOGLE_API_KEY:-}" ]; then
    graphify extract docs --backend gemini --force
    cp docs/graphify-out/graph.json graphify-out/docs-graph.json
    graphify extract llm --backend gemini --force
    cp llm/graphify-out/graph.json graphify-out/llm-graph.json
    echo "Semantic extraction (docs/llm) refreshed via Gemini."
else
    echo "No GEMINI_API_KEY/GOOGLE_API_KEY set: docs+llm graphs kept as-is (code-only refresh)." >&2
    echo "Set GEMINI_API_KEY (pip install 'graphifyy[gemini]') and re-run for full refresh." >&2
fi

exec llm/graphify-update "$@"
